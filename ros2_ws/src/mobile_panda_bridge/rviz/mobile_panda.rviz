Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 20
      Offset:
        X: 0
        Y: 0
        Z: -0.9196429
    - Class: rviz_default_plugins/RobotModel
      Name: Mobile Panda
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Pose
      Name: Base pose
      Enabled: true
      Topic:
        Value: /mobile_panda/base_pose
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Shape: Axes
      Axes Length: 0.6
      Axes Radius: 0.03
    - Class: rviz_default_plugins/Image
      Name: Base camera RGB
      Enabled: true
      Topic:
        Value: /mobile_panda/base_camera/rgb
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: Hand camera RGB
      Enabled: true
      Topic:
        Value: /mobile_panda/hand_camera/rgb
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: chassis_link
      Distance: 3.5
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 900
