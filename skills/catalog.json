    {
      "id": "classical_pick",
      "name": "从上方抓起物体",
      "kind": "classical",
      "download": false,
      "robot": "mobile_panda_wheels / mobile_panda_planar",
      "runs_in": "MobilePandaKitchen",
      "control_mode": "joint delta",
      "code": "mobile_panda_sim/manipulation/skills.py",
      "call": "ManipulationSkills(MujocoWorld(scene)).pick(name)",
      "demo": "scripts/demo_manipulation.py",
      "observation": "仿真真值（物体网格与位姿、把手位置、关节轴），不经过视觉",
      "preconditions": "底盘停稳；目标在机械臂可达范围内（把手高于约 0.55 m；可用 suggest_base_pose 选停靠位置）",
      "validated": {
        "results": {
          "entry_console sugar_box/pear/lemon": "15/15"
        },
        "criterion": "技能返回成功，且没有碰动其他物体超过 2 cm",
        "environment": "Ubuntu 22.04, MuJoCo 3.5.0, wheels base, 2026-11-05"
      },
      "docs": "docs/manipulation.md",
      "applies_to": "窄边小于 7.5 cm、放在够得着的台面上的物体，从上方抓",
      "not_for": "从侧面抓；抽屉和冰箱里的物品；台面靠墙一侧太远的物品"
