      "validated": {
        "results": {
          "sugar_box, pear, lemon": "24/24"
        },
        "criterion": "技能返回成功，且没有碰动其他物体超过 2 cm",
        "environment": "Ubuntu 22.04, MuJoCo 3.5.0, wheels base, 2026-11-05"
      }
    },
